#!/usr/bin/env python3
"""
Port Scanner GUI
-----------------
A simple, multi-threaded TCP port scanner with a Tkinter GUI, styled using
ttkthemes.ThemedTk.

Requirements:
    pip install ttkthemes

Usage:
    python port_scanner.py

Notes:
    - Only scan hosts/networks you own or have explicit permission to test.
      Unauthorized port scanning may be illegal in your jurisdiction.
"""

import socket
import shutil
import subprocess
import threading
import queue
import time
import xml.etree.ElementTree as ET
from datetime import datetime

import tkinter as tk
from tkinter import ttk, messagebox

try:
    from ttkthemes import ThemedTk
except ImportError:
    raise SystemExit(
        "Missing dependency 'ttkthemes'. Install it with:\n\n    pip install ttkthemes\n"
    )

# Common ports mapped to service names, used for a quick description in results
COMMON_PORTS = {
    21: "FTP", 22: "SSH", 23: "Telnet", 25: "SMTP", 53: "DNS",
    80: "HTTP", 110: "POP3", 111: "RPCbind", 135: "MSRPC",
    139: "NetBIOS", 143: "IMAP", 443: "HTTPS", 445: "SMB",
    993: "IMAPS", 995: "POP3S", 1433: "MSSQL", 1723: "PPTP",
    3306: "MySQL", 3389: "RDP", 5432: "PostgreSQL", 5900: "VNC",
    6379: "Redis", 8080: "HTTP-Proxy", 8443: "HTTPS-Alt", 27017: "MongoDB",
}


class PortScannerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Port Scanner")
        self.root.geometry("820x620")
        self.root.minsize(640, 480)

        self._configure_styles()

        # Scan control state
        self.scan_thread = None
        self.stop_flag = threading.Event()
        self.result_queue = queue.Queue()
        self.total_ports = 0
        self.scanned_ports = 0
        self.open_count = 0
        self.nmap_path = shutil.which("nmap")
        self.nmap_process = None
        self.current_scan_type = "tcp_connect"
        self.scan_note = ""
        self.scan_error = ""

        self._build_menu()
        self._build_layout()
        self._poll_queue()

    # ------------------------------------------------------------------ UI

    def _configure_styles(self):
        style = ttk.Style(self.root)

        self.root.configure(bg="#1b2430")

        style.configure("TFrame", background="#1b2430")
        style.configure("TLabel", background="#1b2430", foreground="#f3f4f6")
        style.configure("TCheckbutton", background="#1b2430", foreground="#f3f4f6")
        style.configure("TButton",
                        background="#1e3a5f",
                        foreground="#f8fbff",
                        borderwidth=1,
                        focusthickness=1,
                        focuscolor="#60a5fa")
        style.map("TButton",
                  background=[("active", "#2563eb"), ("pressed", "#1d4ed8")],
                  foreground=[("active", "#ffffff"), ("pressed", "#ffffff")])
        style.configure("TEntry",
                        fieldbackground="#ffffff",
                        foreground="#111827",
                        background="#ffffff",
                        borderwidth=1,
                        relief="solid")
        style.configure("TLabelframe", background="#1b2430")
        style.configure("TLabelframe.Label", background="#1b2430", foreground="#f3f4f6")
        style.configure("TLabelframe.border", background="#32465d", relief="solid")
        style.configure("Horizontal.TProgressbar",
                        background="#60a5fa",
                        troughcolor="#2b3744",
                        bordercolor="#3b4a5a",
                        lightcolor="#60a5fa",
                        darkcolor="#1d4ed8")

        style.configure("Treeview",
                        rowheight=28,
                        font=("TkDefaultFont", 10),
                        fieldbackground="#ffffff",
                        background="#ffffff",
                        foreground="#111827")
        style.configure("Treeview.Heading",
                        font=("TkDefaultFont", 10, "bold"),
                        background="#dfe6f1",
                        foreground="#111827")
        style.map("Treeview",
                  background=[("selected", "#dbeafe")],
                  foreground=[("selected", "#111827")])
        style.map("Treeview.Heading",
                  background=[("active", "#d0dbef")],
                  foreground=[("active", "#111827")])

    def _build_menu(self):
        menubar = tk.Menu(self.root)

        theme_menu = tk.Menu(menubar, tearoff=0)
        available_themes = sorted(self.root.get_themes())
        for theme in available_themes:
            theme_menu.add_command(
                label=theme, command=lambda t=theme: self.root.set_theme(t)
            )
        menubar.add_cascade(label="Theme", menu=theme_menu)

        self.root.config(menu=menubar)

    def _build_layout(self):
        outer = ttk.Frame(self.root, padding=12)
        outer.pack(fill="both", expand=True)

        # ---- Input frame -------------------------------------------------
        input_frame = ttk.LabelFrame(outer, text="Scan Settings", padding=10)
        input_frame.pack(fill="x", pady=(0, 10))

        for col in range(6):
            input_frame.columnconfigure(col, weight=1)

        ttk.Label(input_frame, text="Target Host / IP:").grid(
            row=0, column=0, sticky="w", padx=4, pady=4
        )
        self.host_var = tk.StringVar(value="127.0.0.1")
        ttk.Entry(input_frame, textvariable=self.host_var).grid(
            row=0, column=1, columnspan=3, sticky="ew", padx=4, pady=4
        )

        self.start_port_label = ttk.Label(input_frame, text="Start Port:")
        self.start_port_label.grid(
            row=1, column=0, sticky="w", padx=4, pady=4
        )
        self.start_port_var = tk.StringVar(value="1")
        self.start_port_entry = ttk.Entry(
            input_frame, textvariable=self.start_port_var, width=8
        )
        self.start_port_entry.grid(
            row=1, column=1, sticky="w", padx=4, pady=4
        )

        self.end_port_label = ttk.Label(input_frame, text="End Port:")
        self.end_port_label.grid(
            row=1, column=2, sticky="w", padx=4, pady=4
        )
        self.end_port_var = tk.StringVar(value="1024")
        self.end_port_entry = ttk.Entry(
            input_frame, textvariable=self.end_port_var, width=8
        )
        self.end_port_entry.grid(
            row=1, column=3, sticky="w", padx=4, pady=4
        )

        self.thread_label = ttk.Label(input_frame, text="Threads:")
        self.thread_label.grid(
            row=1, column=4, sticky="w", padx=4, pady=4
        )
        self.thread_var = tk.StringVar(value="100")
        self.thread_entry = ttk.Entry(input_frame, textvariable=self.thread_var, width=8)
        self.thread_entry.grid(
            row=1, column=5, sticky="w", padx=4, pady=4
        )

        self.timeout_label = ttk.Label(input_frame, text="Timeout (s):")
        self.timeout_label.grid(
            row=2, column=0, sticky="w", padx=4, pady=4
        )
        self.timeout_var = tk.StringVar(value="0.5")
        self.timeout_entry = ttk.Entry(input_frame, textvariable=self.timeout_var, width=8)
        self.timeout_entry.grid(
            row=2, column=1, sticky="w", padx=4, pady=4
        )

        self.only_open_var = tk.BooleanVar(value=True)
        self.only_open_check = ttk.Checkbutton(
            input_frame, text="Show only open ports", variable=self.only_open_var
        )
        self.only_open_check.grid(row=2, column=2, columnspan=2, sticky="w", padx=4, pady=4)

        ttk.Label(input_frame, text="Scan mode:").grid(
            row=3, column=0, sticky="w", padx=4, pady=4
        )
        self.port_mode_var = tk.StringVar(value="range")
        self.port_mode_buttons = [ttk.Radiobutton(
            input_frame, text="Port range", variable=self.port_mode_var,
            value="range", command=self._update_port_mode
        ), ttk.Radiobutton(
            input_frame, text="Single port", variable=self.port_mode_var,
            value="single", command=self._update_port_mode
        )]
        for column, button in zip((1, 2), self.port_mode_buttons):
            button.grid(row=3, column=column, sticky="w", padx=4, pady=4)

        ttk.Label(input_frame, text="Scan type:").grid(
            row=4, column=0, sticky="w", padx=4, pady=4
        )
        self.scan_type_var = tk.StringVar(value="tcp_connect")
        scan_types = (
            ("TCP connect", "tcp_connect"),
            ("TCP SYN (stealth)", "tcp_syn"),
            ("ACK", "ack"),
            ("Idle (unavailable)", "idle"),
            ("UDP", "udp"),
            ("IP protocol", "ip_protocol"),
            ("Ping", "ping"),
            ("Version detection", "version"),
            ("OS detection", "os_detection"),
        )
        for index, (label, value) in enumerate(scan_types):
            button = ttk.Radiobutton(
                input_frame,
                text=label,
                variable=self.scan_type_var,
                value=value,
                command=self._update_scan_controls,
                state="disabled" if value == "idle" else "normal",
            )
            button.grid(
                row=4 + index // 3,
                column=index % 3 * 2,
                columnspan=2,
                sticky="w",
                padx=4,
                pady=4,
            )

        # ---- Buttons -------------------------------------------------
        btn_frame = ttk.Frame(outer)
        btn_frame.pack(fill="x", pady=(0, 10))

        self.start_btn = ttk.Button(btn_frame, text="Start Scan", command=self.start_scan)
        self.start_btn.pack(side="left", padx=(0, 6))

        self.stop_btn = ttk.Button(
            btn_frame, text="Stop", command=self.stop_scan, state="disabled"
        )
        self.stop_btn.pack(side="left", padx=(0, 6))

        self.clear_btn = ttk.Button(btn_frame, text="Clear Results", command=self.clear_results)
        self.clear_btn.pack(side="left")

        self.status_var = tk.StringVar(value="Idle")
        ttk.Label(btn_frame, textvariable=self.status_var, anchor="e").pack(
            side="right", fill="x", expand=True
        )

        # ---- Progress bar -------------------------------------------------
        self.progress = ttk.Progressbar(outer, mode="determinate")
        self.progress.pack(fill="x", pady=(0, 10))

        # ---- Results table -------------------------------------------------
        table_frame = ttk.LabelFrame(outer, text="Results", padding=(8, 6))
        table_frame.pack(fill="both", expand=True)

        columns = ("port", "status", "service")
        self.tree = ttk.Treeview(
            table_frame,
            columns=columns,
            show="headings",
            selectmode="browse",
            height=16,
        )
        self.tree.heading("port", text="Port")
        self.tree.heading("status", text="Status")
        self.tree.heading("service", text="Likely Service")
        self.tree.column("port", width=90, minwidth=80, anchor="center", stretch=False)
        self.tree.column("status", width=120, minwidth=100, anchor="center", stretch=False)
        self.tree.column("service", width=260, minwidth=180, anchor="w", stretch=True)

        vsb = ttk.Scrollbar(table_frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=vsb.set)

        self.tree.pack(side="left", fill="both", expand=True, padx=(0, 4))
        vsb.pack(side="right", fill="y")

        self.tree.tag_configure("open", foreground="#1a8a1a", font=("TkDefaultFont", 10, "bold"))
        self.tree.tag_configure("closed", foreground="#6b7280")

        # ---- Log / summary -------------------------------------------------
        self.summary_var = tk.StringVar(value="")
        ttk.Label(outer, textvariable=self.summary_var, anchor="w").pack(
            fill="x", pady=(8, 0)
        )

    # ------------------------------------------------------------- Actions

    def _update_port_mode(self):
        self._update_scan_controls()

    def _update_scan_controls(self):
        scan_type = self.scan_type_var.get()
        uses_ports = scan_type not in ("ping", "ip_protocol")
        single_port = self.port_mode_var.get() == "single"
        self.start_port_label.configure(
            text="Port:" if single_port else "Start Port:",
            state="normal" if uses_ports else "disabled",
        )
        self.start_port_entry.configure(state="normal" if uses_ports else "disabled")
        self.end_port_label.configure(
            state="normal" if uses_ports and not single_port else "disabled"
        )
        self.end_port_entry.configure(
            state="normal" if uses_ports and not single_port else "disabled"
        )
        for button in self.port_mode_buttons:
            button.configure(state="normal" if uses_ports else "disabled")
        uses_threads = scan_type == "tcp_connect"
        self.thread_label.configure(state="normal" if uses_threads else "disabled")
        self.thread_entry.configure(state="normal" if uses_threads else "disabled")
        self.timeout_label.configure(state="normal" if uses_threads else "disabled")
        self.timeout_entry.configure(state="normal" if uses_threads else "disabled")
        filters_open_ports = scan_type in (
            "tcp_connect", "tcp_syn", "udp", "version", "os_detection"
        )
        self.only_open_check.configure(
            state="normal" if filters_open_ports else "disabled"
        )

    def _validate_inputs(self):
        host = self.host_var.get().strip()
        if not host:
            messagebox.showerror("Invalid input", "Please enter a target host or IP.")
            return None

        scan_type = self.scan_type_var.get()
        single_port = self.port_mode_var.get() == "single"
        if scan_type == "idle":
            messagebox.showerror("Unavailable scan", "Idle scan is not supported.")
            return None

        if scan_type in ("ping", "ip_protocol"):
            start_port = end_port = None
        else:
            try:
                start_port = int(self.start_port_var.get())
                end_port = start_port if single_port else int(self.end_port_var.get())
            except ValueError:
                messagebox.showerror("Invalid input", "Ports must be integers.")
                return None

            if not (0 < start_port <= 65535 and 0 < end_port <= 65535):
                messagebox.showerror("Invalid input", "Ports must be between 1 and 65535.")
                return None

            if start_port > end_port:
                messagebox.showerror("Invalid input", "Start port must be <= end port.")
                return None

        num_threads = 1
        timeout = 0.5
        if scan_type == "tcp_connect":
            try:
                num_threads = int(self.thread_var.get())
                if num_threads < 1:
                    raise ValueError
            except ValueError:
                messagebox.showerror("Invalid input", "Threads must be a positive integer.")
                return None

            try:
                timeout = float(self.timeout_var.get())
                if timeout <= 0:
                    raise ValueError
            except ValueError:
                messagebox.showerror("Invalid input", "Timeout must be a positive number.")
                return None

        try:
            resolved_ip = socket.gethostbyname(host)
        except socket.gaierror:
            messagebox.showerror("Invalid input", f"Could not resolve host: {host}")
            return None

        return {
            "host": host,
            "resolved_ip": resolved_ip,
            "start_port": start_port,
            "end_port": end_port,
            "single_port": single_port,
            "scan_type": scan_type,
            "num_threads": num_threads,
            "timeout": timeout,
        }

    def start_scan(self):
        if self.scan_thread and self.scan_thread.is_alive():
            return

        params = self._validate_inputs()
        if params is None:
            return

        self.clear_results()
        self.total_ports = (
            1 if params["scan_type"] == "ping"
            else 256 if params["scan_type"] == "ip_protocol"
            else params["end_port"] - params["start_port"] + 1
        )
        self.scanned_ports = 0
        self.open_count = 0
        self.current_scan_type = params["scan_type"]
        self.scan_note = ""
        self.scan_error = ""
        self.progress.configure(maximum=self.total_ports, value=0)

        self.stop_flag.clear()
        self.start_btn.configure(state="disabled")
        self.stop_btn.configure(state="normal")
        if params["scan_type"] == "ping":
            port_description = "host discovery"
        elif params["scan_type"] == "ip_protocol":
            port_description = "IP protocols"
        elif params["single_port"]:
            port_description = f"port {params['start_port']}"
        else:
            port_description = f"ports {params['start_port']}-{params['end_port']}"
        self.status_var.set(
            f"Running {params['scan_type'].replace('_', ' ')} on "
            f"{params['host']} ({params['resolved_ip']}) — "
            f"{port_description}..."
        )

        self.scan_start_time = time.time()
        self.scan_thread = threading.Thread(
            target=self._run_scan, args=(params,), daemon=True
        )
        self.scan_thread.start()

    def stop_scan(self):
        self.stop_flag.set()
        self.status_var.set("Stopping...")
        self.stop_btn.configure(state="disabled")

    def clear_results(self):
        for row in self.tree.get_children():
            self.tree.delete(row)
        self.progress.configure(value=0)
        self.summary_var.set("")

    # ------------------------------------------------------------ Scanning

    def _run_scan(self, params):
        if params["scan_type"] != "tcp_connect":
            self._run_nmap_scan(params)
            return

        host = params["resolved_ip"]
        ports = list(range(params["start_port"], params["end_port"] + 1))
        port_queue = queue.Queue()
        for p in ports:
            port_queue.put(p)

        lock = threading.Lock()

        def worker():
            while not self.stop_flag.is_set():
                try:
                    port = port_queue.get_nowait()
                except queue.Empty:
                    return
                is_open = self._check_port(host, port, params["timeout"])
                service = COMMON_PORTS.get(port, "")
                self.result_queue.put((
                    "result", port, "open" if is_open else "closed", service, 1
                ))
                port_queue.task_done()

        num_threads = min(params["num_threads"], len(ports)) or 1
        threads = [threading.Thread(target=worker, daemon=True) for _ in range(num_threads)]
        for t in threads:
            t.start()
        for t in threads:
            t.join()

        elapsed = time.time() - self.scan_start_time
        self.result_queue.put(("done", elapsed, self.stop_flag.is_set()))

    def _run_nmap_scan(self, params):
        started_at = time.time()
        process = None
        try:
            if not self.nmap_path:
                raise RuntimeError("Nmap is required for this scan type but was not found.")

            scan_type = params["scan_type"]
            command = [self.nmap_path, "-n", "-oX", "-"]
            if scan_type == "ping":
                command.append("-sn")
            else:
                switches = {
                    "tcp_syn": "-sS",
                    "ack": "-sA",
                    "udp": "-sU",
                    "ip_protocol": "-sO",
                    "version": "-sV",
                    "os_detection": "-O",
                }
                command.append(switches[scan_type])
                if scan_type != "ip_protocol":
                    port_range = str(params["start_port"])
                    if params["end_port"] != params["start_port"]:
                        port_range += f"-{params['end_port']}"
                    command.extend(("-p", port_range))
                command.append("-Pn")
            command.extend(("--", params["resolved_ip"]))

            process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
            self.nmap_process = process
            while True:
                try:
                    stdout, stderr = process.communicate(timeout=0.1)
                    break
                except subprocess.TimeoutExpired:
                    if not self.stop_flag.is_set():
                        continue
                    process.terminate()
                    try:
                        stdout, stderr = process.communicate(timeout=3)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        stdout, stderr = process.communicate()
                    break

            if not self.stop_flag.is_set():
                if process.returncode:
                    detail = stderr.strip() or stdout.strip()
                    raise RuntimeError(detail or f"Nmap exited with status {process.returncode}.")
                self._queue_nmap_results(stdout, scan_type)
        except (OSError, ET.ParseError, RuntimeError) as error:
            self.result_queue.put(("error", str(error)))
        finally:
            self.nmap_process = None
            elapsed = time.time() - started_at
            self.result_queue.put(("done", elapsed, self.stop_flag.is_set()))

    def _queue_nmap_results(self, output, scan_type):
        root = ET.fromstring(output)
        if scan_type == "ping":
            host = root.find("host")
            status = host.find("status") if host is not None else None
            state = status.get("state", "down") if status is not None else "down"
            self.result_queue.put(("result", "Host", state, "", 1))
            return

        for host in root.findall("host"):
            for port in host.findall("./ports/port"):
                protocol = port.get("protocol", "tcp").upper()
                port_number = port.get("portid", "?")
                if protocol == "IP":
                    port_number = f"IP/{port_number}"
                state_element = port.find("state")
                state = state_element.get("state", "unknown") if state_element is not None else "unknown"
                service_element = port.find("service")
                service = ""
                if service_element is not None:
                    service = " ".join(
                        part for part in (
                            service_element.get("name", ""),
                            service_element.get("product", ""),
                            service_element.get("version", ""),
                        ) if part
                    )
                self.result_queue.put(("result", port_number, state, service, 1))

            for extra in host.findall("./ports/extraports"):
                state = extra.get("state", "unknown")
                try:
                    count = int(extra.get("count", "0"))
                except ValueError:
                    count = 0
                if count:
                    self.result_queue.put((
                        "result", f"Other ports ({count})", state,
                        f"{count} ports grouped by Nmap", count,
                    ))

            if scan_type == "os_detection":
                os_match = host.find("./os/osmatch")
                if os_match is not None:
                    name = os_match.get("name", "Unknown OS")
                    accuracy = os_match.get("accuracy", "")
                    note = f"OS detection: {name} ({accuracy}% accuracy)" if accuracy else f"OS detection: {name}"
                    self.result_queue.put(("note", note))

    @staticmethod
    def _check_port(host, port, timeout):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            result = sock.connect_ex((host, port))
            return result == 0
        except socket.error:
            return False
        finally:
            sock.close()

    # --------------------------------------------------------------- Queue

    def _poll_queue(self):
        try:
            while True:
                item = self.result_queue.get_nowait()
                if item[0] == "result":
                    _, port, status, service, count = item
                    state = status.lower()
                    self.scanned_ports += count
                    self.progress.configure(
                        value=min(self.scanned_ports, self.total_ports)
                    )

                    is_positive = state == "open" or (
                        self.current_scan_type == "ping" and state == "up"
                    )
                    if is_positive:
                        self.open_count += count

                    show_all = self.current_scan_type in (
                        "ack", "ip_protocol", "ping"
                    )
                    if show_all or is_positive or not self.only_open_var.get():
                        self.tree.insert(
                            "", "end",
                            values=(port, state.upper(), service),
                            tags=("open" if is_positive else "closed",),
                        )

                elif item[0] == "done":
                    _, elapsed, was_stopped = item
                    self.start_btn.configure(state="normal")
                    self.stop_btn.configure(state="disabled")
                    state_text = (
                        "Failed" if self.scan_error
                        else "Stopped" if was_stopped
                        else "Completed"
                    )
                    self.status_var.set(f"{state_text} in {elapsed:.2f}s")
                    summary = (
                        f"Scanned {self.scanned_ports}/{self.total_ports} items — "
                        f"{self.open_count} open/responding — "
                        f"finished {datetime.now().strftime('%H:%M:%S')}"
                    )
                    if self.scan_note:
                        summary += f" — {self.scan_note}"
                    if self.scan_error:
                        summary = f"Scan failed: {self.scan_error}"
                    self.summary_var.set(
                        summary
                    )
                elif item[0] == "note":
                    self.scan_note = item[1]
                elif item[0] == "error":
                    self.scan_error = item[1]
        except queue.Empty:
            pass
        finally:
            self.root.after(50, self._poll_queue)


def main():
    root = ThemedTk(theme="equilux")
    app = PortScannerApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()